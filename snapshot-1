<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>Cube Dungeons</title>
<style>
  html,body{margin:0;padding:0;overflow:hidden;background:#0b0e16;height:100%;}
  canvas{display:block;cursor:crosshair;}
</style>
</head>
<body>
<canvas id="cv"></canvas>
<input type="file" id="fileIn" accept="image/png" style="display:none">
<script>
'use strict';
// ================= базовое =================
const cv = document.getElementById('cv');
const ctx = cv.getContext('2d');
let W = innerWidth, H = innerHeight;
function resize(){ W = innerWidth; H = innerHeight; cv.width = W; cv.height = H; }
addEventListener('resize', resize); resize();

const clamp=(v,a,b)=>v<a?a:(v>b?b:v);
const dist2=(x1,y1,x2,y2)=>Math.hypot(x1-x2,y1-y2);
const rnd=(a,b)=>a+Math.random()*(b-a);

// ================= скины =================
let skins = [];        // [{name, data}]
let skinImgs = [];     // Image[]
let selSkin = -1;
function saveSkins(){ try{ localStorage.setItem('cd_skins', JSON.stringify({list:skins, sel:selSkin})); }catch(e){} }
function loadSkins(){
  try{
    const d = JSON.parse(localStorage.getItem('cd_skins')||'{"list":[],"sel":-1}');
    skins = d.list||[]; selSkin = d.sel;
  }catch(e){ skins=[]; selSkin=-1; }
  if(typeof selSkin!=='number') selSkin=-1;
  if(selSkin>=skins.length) selSkin = skins.length-1;
  rebuildSkinImgs();
}
function rebuildSkinImgs(){
  skinImgs = skins.map(s=>{ const im=new Image(); im.src=s.data; return im; });
}
function skinImgOf(i){
  if(i>=0 && skinImgs[i] && skinImgs[i].complete && skinImgs[i].naturalWidth>0) return skinImgs[i];
  return null;
}
loadSkins();

// ================= персонаж =================
function drawChar(c, x, y, size, rot, ph, im){
  c.save(); c.translate(x,y);
  const a = Math.atan2(Math.sin(rot), Math.cos(rot));
  const dir = (Math.cos(a)>=0)?1:-1;
  const u = size/32; c.scale(dir*u, u);
  const sw = Math.sin(ph)*2.5;
  const ok = im && im.complete && im.naturalWidth>0;
  // ноги
  if(ok){ c.drawImage(im,4,16,4,12,-4,-12+sw*0.4,4,12); c.drawImage(im,20,16,4,12,0,-12-sw*0.4,4,12); }
  else { c.fillStyle='#3b4d86'; c.fillRect(-4,-12+sw*0.4,4,12); c.fillRect(0,-12-sw*0.4,4,12); }
  // тело
  if(ok){ c.drawImage(im,20,20,8,12,-4,-24,8,12); }
  else { c.fillStyle='#2f7d4f'; c.fillRect(-4,-24,8,12); }
  // руки
  c.save(); c.translate(-4,-24); c.rotate(0.15+sw*0.06);
  if(ok) c.drawImage(im,44,20,4,12,0,0,4,12); else { c.fillStyle='#c98b5e'; c.fillRect(0,0,4,12); }
  c.restore();
  c.save(); c.translate(4,-24); c.rotate(-0.15+sw*0.06);
  if(ok) c.drawImage(im,44,20,4,12,0,0,4,12); else { c.fillStyle='#c98b5e'; c.fillRect(0,0,4,12); }
  c.restore();
  // голова
  if(ok){ c.drawImage(im,8,8,8,8,-4,-32,8,8); }
  else { c.fillStyle='#c98b5e'; c.fillRect(-4,-32,8,8); c.fillStyle='#1c1c22'; c.fillRect(-2.5,-29,1.6,1.6); c.fillRect(0.9,-29,1.6,1.6); }
  c.restore();
}

// ================= состояние =================
const ST = {MENU:0, PLAY:1, PAUSE:2, DEAD:3, OVER:4};
let state = ST.MENU;
let heroOpen=false, shopOpen=false, invOpen=false, exitOpen=false, setPanel=null; // setPanel: 'acc'|'set'
let msg='', msgT=0;
let waveBanner='', waveBannerT=0;
let saveTick=0;

const player = {x:0,y:0,hp:100,maxHp:100,souls:0,emeralds:0,arrows:0,potions:0,
  weapon:'stone', hasBow:false, rot:0, ph:0, atkCd:0, atkAnim:0, tx:0, ty:0, hasTarget:false, walkPh:0};

let mobs=[], items=[], arrows=[], particles=[];
let wave=1, waveState='rest', waveTimer=3;
let cam={x:0,y:0};
let menuPh=0;

const WEAP = {stone:{name:'Каменный',dmg:12},gold:{name:'Золотой',dmg:22},diamond:{name:'Алмазный',dmg:35}};
const houses=[]; for(let i=0;i<6;i++){ const a=i*Math.PI/3+0.4; houses.push({x:Math.cos(a)*300,y:Math.sin(a)*300,hp:100,maxHp:100}); }
let villagers=[]; function spawnVillagers(){ villagers=[]; for(let i=0;i<4;i++){ const a=rnd(0,6.28); villagers.push({x:Math.cos(a)*140,y:Math.sin(a)*140,hp:50,maxHp:50,tx:0,ty:0,wt:0}); } }

function resetGame(){
  mobs=[]; items=[]; arrows=[]; particles=[];
  player.x=0; player.y=60; player.hp=100; player.maxHp=100; player.souls=0;
  player.emeralds=12; player.arrows=0; player.potions=1; player.weapon='stone'; player.hasBow=false;
  player.rot=0; player.ph=0; player.atkCd=0; player.hasTarget=false;
  for(const h of houses){ h.hp=h.maxHp; }
  spawnVillagers();
  wave=1; waveState='rest'; waveTimer=4;
  cam.x=player.x-W/2; cam.y=player.y-H/2;
}

// ================= сохранение =================
function hasSave(){ try{ return !!localStorage.getItem('cd_save'); }catch(e){ return false; } }
function doSave(){
  try{
    localStorage.setItem('cd_save', JSON.stringify({
      p:{x:player.x,y:player.y,hp:player.hp,souls:player.souls,emeralds:player.emeralds,
         arrows:player.arrows,potions:player.potions,weapon:player.weapon,hasBow:player.hasBow},
      wave:wave, hs:houses.map(h=>h.hp), items:items.slice(0,40),
      vhp:villagers.map(v=>v.hp)
    }));
  }catch(e){}
}
function doLoad(){
  try{
    const d = JSON.parse(localStorage.getItem('cd_save'));
    if(!d) return false;
    resetGame();
    Object.assign(player, d.p);
    wave = d.wave||1;
    if(d.hs) d.hs.forEach((v,i)=>{ if(houses[i]) houses[i].hp=v; });
    if(d.items) items = d.items.map(it=>({x:it.x,y:it.y,type:it.type}));
    if(d.vhp) d.vhp.forEach((v,i)=>{ if(villagers[i]) villagers[i].hp=v; });
    cam.x=player.x-W/2; cam.y=player.y-H/2;
    waveBanner='Волна '+wave; waveBannerT=2;
    return true;
  }catch(e){ return false; }
}

// ================= ввод =================
let keys={};
let mx=W/2, my=H/2;
cv.addEventListener('contextmenu', e=>e.preventDefault());
cv.addEventListener('mousemove', e=>{ mx=e.clientX; my=e.clientY; });
let buttons=[];
cv.addEventListener('mousedown', e=>{
  const x=e.clientX, y=e.clientY;
  for(const b of buttons){ if(x>=b.x&&x<=b.x+b.w&&y>=b.y&&y<=b.y+b.h){ b.fn(); return; } }
  if(state===ST.PLAY && !shopOpen && !invOpen){
    if(e.button===2){ player.tx=cam.x+x; player.ty=cam.y+y; player.hasTarget=true; }
    if(e.button===0){ shootArrow(); }
  }
});
addEventListener('keydown', e=>{
  keys[e.code]=true;
  if(e.code==='Tab'){ e.preventDefault(); if(state===ST.PLAY){ invOpen=!invOpen; shopOpen=false; } }
  if(state===ST.PLAY && !shopOpen && !invOpen){
    if(e.code==='KeyX'||e.code==='KeyK') melee();
    if(e.code==='KeyT'||e.code==='KeyE') special();
    if(e.code==='KeyQ'||e.code==='KeyJ') drinkPotion();
    if(e.code==='KeyF'||e.code==='KeyA2') interact();
    if(e.code==='KeyC') shootArrow();
    if(e.code==='Escape'){ state=ST.PAUSE; }
  } else if(shopOpen && e.code==='Escape'){ shopOpen=false; }
  else if(invOpen && e.code==='Escape'){ invOpen=false; }
  else if(state===ST.PAUSE && e.code==='Escape'){ state=ST.PLAY; }
  else if(state===ST.MENU && e.code==='KeyH'){ heroOpen=!heroOpen; }
  else if(heroOpen && e.code==='Escape'){ heroOpen=false; }
  else if(setPanel && e.code==='Escape'){ setPanel=null; }
  else if(exitOpen && e.code==='Escape'){ exitOpen=false; }
});
addEventListener('keyup', e=>{ keys[e.code]=false; });

// ================= действия =================
function melee(){
  if(player.atkCd>0) return;
  player.atkCd=0.4; player.atkAnim=0.25;
  const dmg=WEAP[player.weapon].dmg;
  for(const m of mobs){
    const d=dist2(m.x,m.y,player.x,player.y);
    if(d<75){ const a=Math.atan2(m.y-player.y,m.x-player.x);
      let da=Math.abs(a-player.rot); if(da>Math.PI) da=2*Math.PI-da;
      if(da<1.6){ hurtMob(m,dmg); } }
  }
}
function special(){
  if(player.souls<100) { flash('Шкала душ не полна'); return; }
  player.souls=0;
  for(let i=0;i<40;i++) particles.push({x:player.x,y:player.y,vx:rnd(-200,200),vy:rnd(-200,200),t:0.6,c:'#6cc4ff'});
  for(const m of mobs){ if(dist2(m.x,m.y,player.x,player.y)<180) hurtMob(m,60); }
  flash('Особая атака!');
}
function shootArrow(){
  if(state!==ST.PLAY||!player.hasBow) return;
  if(player.arrows<=0){ flash('Нет стрел'); return; }
  player.arrows--;
  const a=Math.atan2(my+cam.y-(player.y-20), mx+cam.x-player.x);
  arrows.push({x:player.x,y:player.y-20,vx:Math.cos(a)*420,vy:Math.sin(a)*420,t:1.6});
}
function drinkPotion(){
  if(player.potions<=0){ flash('Нет зелий'); return; }
  player.potions--; player.hp=clamp(player.hp+50,0,player.maxHp);
  for(let i=0;i<14;i++) particles.push({x:player.x,y:player.y-20,vx:rnd(-60,60),vy:rnd(-90,-20),t:0.7,c:'#e44'});
  flash('Зелье выпито');
}
function interact(){
  // подбор предметов
  let best=null,bd=55;
  for(const it of items){ const d=dist2(it.x,it.y,player.x,player.y); if(d<bd){bd=d;best=it;} }
  if(best){
    if(best.type==='emerald'){ player.emeralds++; }
    else { player.potions++; }
    items.splice(items.indexOf(best),1);
    return;
  }
  // торговля
  for(const v of villagers){
    if(v.hp>0 && dist2(v.x,v.y,player.x,player.y)<80){ shopOpen=true; return; }
  }
  flash('Рядом нет жителя или предмета');
}
function hurtMob(m,dmg){
  m.hp-=dmg; m.flash=0.15;
  if(m.hp<=0){
    mobs.splice(mobs.indexOf(m),1);
    player.souls=clamp(player.souls+10,0,100);
    const r=Math.random();
    if(r<0.6) items.push({x:m.x,y:m.y,type:'emerald'});
    else if(r<0.72) items.push({x:m.x,y:m.y,type:'potion'});
  }
}
function hurtHouse(h,dmg){ h.hp=clamp(h.hp-dmg,0,h.maxHp); }
function flash(t){ msg=t; msgT=1.6; }

// ================= волны =================
function spawnWave(){
  waveState='fight'; waveBanner='Волна '+wave; waveBannerT=2;
  const nZ=3+wave*2, nC=wave>=2?wave:1;
  for(let i=0;i<nZ;i++){
    const a=rnd(0,6.28), r=700+rnd(0,120);
    mobs.push({type:'z',x:Math.cos(a)*r,y:Math.sin(a)*r,hp:26+wave*5,maxHp:26+wave*5,cd:0,flash:0});
  }
  for(let i=0;i<nC;i++){
    const a=rnd(0,6.28), r=700+rnd(0,120);
    mobs.push({type:'c',x:Math.cos(a)*r,y:Math.sin(a)*r,hp:20+wave*3,maxHp:20+wave*3,fuse:-1,flash:0});
  }
}
function updateWave(dt){
  if(waveState==='rest'){
    waveTimer-=dt;
    if(waveTimer<=0){ spawnWave();
      for(const v of villagers){ if(v.hp<=0){ v.hp=50; const a=rnd(0,6.28); v.x=Math.cos(a)*140; v.y=Math.sin(a)*140; } }
    }
  } else {
    if(mobs.length===0){ waveState='rest'; waveTimer=6; wave++;
      player.hp=clamp(player.hp+20,0,player.maxHp);
    }
  }
}

// ================= апдейт =================
function update(dt){
  menuPh+=dt*3;
  if(state!==ST.PLAY) return;
  if(shopOpen||invOpen) return;

  // игрок
  let vx=0,vy=0;
  if(keys['KeyW']||keys['ArrowUp'])vy-=1;
  if(keys['KeyS']||keys['ArrowDown'])vy+=1;
  if(keys['KeyA']||keys['ArrowLeft'])vx-=1;
  if(keys['KeyD']||keys['ArrowRight'])vx+=1;
  if(vx||vy){ player.hasTarget=false; }
  else if(player.hasTarget){
    const d=dist2(player.x,player.y,player.tx,player.ty);
    if(d<8){ player.hasTarget=false; }
    else { vx=(player.tx-player.x)/d; vy=(player.ty-player.y)/d; }
  }
  const sp=160;
  if(vx||vy){
    const l=Math.hypot(vx,vy); vx/=l; vy/=l;
    player.x+=vx*sp*dt; player.y+=vy*sp*dt;
    player.rot=Math.atan2(vy,vx);
    player.walkPh+=dt*10; player.ph=player.walkPh;
  } else player.ph+=dt*2;

  player.atkCd=Math.max(0,player.atkCd-dt);
  player.atkAnim=Math.max(0,player.atkAnim-dt);

  // камера
  cam.x+= (player.x-W/2-cam.x)*Math.min(1,dt*8);
  cam.y+= (player.y-H/2-cam.y)*Math.min(1,dt*8);

  updateWave(dt);

  // мобы
  for(const m of mobs){
    m.flash=Math.max(0,(m.flash||0)-dt);
    let tx=null,ty=null,tIsHouse=false,th=null;
    let bd=1e9;
    if(player.hp>0){ const d=dist2(m.x,m.y,player.x,player.y); if(d<bd){bd=d;tx=player.x;ty=player.y;} }
    for(const v of villagers){ if(v.hp>0){ const d=dist2(m.x,m.y,v.x,v.y); if(d<bd){bd=d;tx=v.x;ty=v.y;} } }
    for(const h of houses){ if(h.hp>0){ const d=dist2(m.x,m.y,h.x,h.y); if(d<bd){bd=d;tx=h.x;ty=h.y;th=h;} } }
    if(tx===null) continue;
    if(m.type==='z'){
      if(bd>34){ m.x+=(tx-m.x)/bd*55*dt; m.y+=(ty-m.y)/bd*55*dt; m.cd=Math.max(0,m.cd-dt); }
      else if(m.cd<=0){
        m.cd=1;
        if(th) hurtHouse(th,8);
        else if(bd<40 && player.hp>0 && dist2(m.x,m.y,player.x,player.y)<40) { player.hp-=8; if(player.hp<=0){ state=ST.DEAD; } }
        else { for(const v of villagers){ if(v.hp>0&&dist2(m.x,m.y,v.x,v.y)<40){ v.hp-=8; if(v.hp<=0){v.hp=0;} break; } } }
      }
    } else {
      if(m.fuse>=0){
        m.fuse-=dt;
        if(m.fuse<=0){
          mobs.splice(mobs.indexOf(m),1);
          for(let i=0;i<30;i++) particles.push({x:m.x,y:m.y,vx:rnd(-260,260),vy:rnd(-260,260),t:0.7,c:'#9e9'});
          // взрыв
          if(dist2(m.x,m.y,player.x,player.y)<100){ player.hp-=30; if(player.hp<=0) state=ST.DEAD; }
          for(const h of houses){ if(h.hp>0&&dist2(m.x,m.y,h.x,h.y)<110) hurtHouse(h,40); }
          for(const v of villagers){ if(v.hp>0&&dist2(m.x,m.y,v.x,v.y)<100) v.hp-=30; }
          for(const mm of mobs.slice()){ if(mm!==m&&dist2(m.x,m.y,mm.x,mm.y)<100) hurtMob(mm,25); }
        }
      } else {
        if(bd>40){ m.x+=(tx-m.x)/bd*75*dt; m.y+=(ty-m.y)/bd*75*dt; }
        else m.fuse=1.2;
      }
    }
  }

  // жители
  for(const v of villagers){
    if(v.hp<=0) continue;
    v.wt-=dt;
    if(v.wt<=0){ v.wt=rnd(1,3); const a=rnd(0,6.28); v.tx=140*Math.cos(a); v.ty=140*Math.sin(a); }
    const d=dist2(v.x,v.y,v.tx,v.ty);
    if(d>6){ v.x+=(v.tx-v.x)/d*30*dt; v.y+=(v.ty-v.y)/d*30*dt; }
  }

  // стрелы
  for(const ar of arrows.slice()){
    ar.t-=dt; ar.x+=ar.vx*dt; ar.y+=ar.vy*dt;
    if(ar.t<=0){ arrows.splice(arrows.indexOf(ar),1); continue; }
    for(const m of mobs){
      if(dist2(m.x,m.y-14,ar.x,ar.y)<26){ hurtMob(m,14); arrows.splice(arrows.indexOf(ar),1); break; }
    }
  }

  // частицы
  for(const p of particles.slice()){ p.t-=dt; p.x+=p.vx*dt; p.y+=p.vy*dt; if(p.t<=0) particles.splice(particles.indexOf(p),1); }

  if(waveBannerT>0) waveBannerT-=dt;
  if(msgT>0) msgT-=dt;
  saveTick+=dt; if(saveTick>6){ saveTick=0; doSave(); }
}

// ================= земля (паттерн) =================
const gpat = (()=>{
  const c=document.createElement('canvas'); c.width=64; c.height=64;
  const g=c.getContext('2d');
  g.fillStyle='#3f6b35'; g.fillRect(0,0,64,64);
  for(let i=0;i<90;i++){ g.fillStyle=Math.random()<0.5?'#3a6330':'#457439';
    g.fillRect(Math.random()*64|0,Math.random()*64|0,3,3); }
  return ctx.createPattern(c,'repeat');
})();

// ================= отрисовка мира =================
function drawWorld(){
  ctx.fillStyle=gpat;
  ctx.save(); ctx.translate(-cam.x%64,-cam.y%64); ctx.fillRect(0,0,W+64,H+64); ctx.restore();

  // колодец
  const wx=0-cam.x, wy=0-cam.y;
  ctx.fillStyle='#8a8f96'; ctx.beginPath(); ctx.arc(wx,wy,26,0,7); ctx.fill();
  ctx.fillStyle='#2c4a6b'; ctx.beginPath(); ctx.arc(wx,wy,16,0,7); ctx.fill();

  // дома
  for(const h of houses){
    const hx=h.x-cam.x, hy=h.y-cam.y;
    if(hx<-120||hx>W+120||hy<-120||hy>H+120) continue;
    ctx.fillStyle='#6b4a2b'; ctx.fillRect(hx-45,hy-60,90,60);
    ctx.fillStyle='#8a6238';
    ctx.beginPath(); ctx.moveTo(hx-52,hy-60); ctx.lineTo(hx,hy-95); ctx.lineTo(hx+52,hy-60); ctx.closePath(); ctx.fill();
    ctx.fillStyle='#4a3118'; ctx.fillRect(hx-10,hy-28,20,28);
    ctx.fillStyle='#a33'; if(h.hp<h.maxHp*0.4) ctx.fillStyle='#d33';
    const bw=90*h.hp/h.maxHp;
    ctx.fillRect(hx-45,hy-104,bw,6);
    ctx.strokeStyle='#000'; ctx.strokeRect(hx-45,hy-104,90,6);
    if(h.hp<=0){ ctx.fillStyle='rgba(60,40,20,0.8)'; ctx.fillRect(hx-45,hy-60,90,60); }
  }

  // предметы
  for(const it of items){
    const ix=it.x-cam.x, iy=it.y-cam.y;
    if(it.type==='emerald'){ ctx.fillStyle='#3ddc6b'; ctx.save(); ctx.translate(ix,iy-8); ctx.rotate(0.7); ctx.fillRect(-5,-5,10,10); ctx.restore(); }
    else { ctx.fillStyle='#c14'; ctx.fillRect(ix-6,iy-14,12,14); ctx.fillStyle='#e77'; ctx.fillRect(ix-4,iy-16,8,4); }
  }

  // жители
  for(const v of villagers){
    if(v.hp<=0) continue;
    const vx2=v.x-cam.x, vy2=v.y-cam.y;
    drawChar(ctx,vx2,vy2,34,0,menuPh*0.5+vx2*0.01,null);
    ctx.fillStyle='#c8a06a'; ctx.fillRect(vx2-2,vy2-26,4,4);
    ctx.fillStyle='#4c4'; ctx.fillRect(vx2-14,vy2-44,28,4);
    ctx.fillStyle='#4c4'; ctx.fillRect(vx2-14,vy2-44,28*v.hp/v.maxHp,4);
  }

  // мобы
  for(const m of mobs){
    const mx2=m.x-cam.x, my2=m.y-cam.y;
    if(mx2<-60||mx2>W+60||my2<-80||my2>H+60) continue;
    if(m.type==='z'){
      ctx.save();
      if(m.flash>0) ctx.globalAlpha=0.5;
      drawChar(ctx,mx2,my2,34,Math.atan2(player.y-m.y,player.x-m.x),menuPh*0.7+mx2*0.02,null);
      ctx.fillStyle='#4a8f3c'; ctx.fillRect(mx2-4,my2-32,8,8);
      ctx.fillStyle='#0a2'; ctx.fillRect(mx2-2.5,my2-30,1.5,1.5); ctx.fillRect(mx2+1,my2-30,1.5,1.5);
      ctx.restore();
      ctx.fillStyle='#900'; ctx.fillRect(mx2-12,my2-42,24,3);
      ctx.fillStyle='#e33'; ctx.fillRect(mx2-12,my2-42,24*m.hp/m.maxHp,3);
    } else {
      const fl = (m.fuse>=0 && Math.sin(m.fuse*30)>0);
      ctx.fillStyle=fl?'#e8ffe8':'#5aa845';
      ctx.fillRect(mx2-9,my2-30,18,22);
      ctx.fillStyle=fl?'#333':'#2c6b2c';
      ctx.fillRect(mx2-6,my2-27,4,4); ctx.fillRect(mx2+2,my2-27,4,4);
      ctx.fillRect(mx2-2,my2-22,4,3);
      ctx.fillStyle=fl?'#e8ffe8':'#5aa845';
      ctx.fillRect(mx2-7,my2-8,4,8); ctx.fillRect(mx2+3,my2-8,4,8);
      ctx.fillStyle='#900'; ctx.fillRect(mx2-12,my2-40,24,3);
      ctx.fillStyle='#e33'; ctx.fillRect(mx2-12,my2-40,24*m.hp/m.maxHp,3);
    }
  }

  // стрелы
  ctx.strokeStyle='#ddd'; ctx.lineWidth=2;
  for(const ar of arrows){
    ctx.beginPath(); ctx.moveTo(ar.x-cam.x,ar.y-cam.y);
    ctx.lineTo(ar.x-cam.x-ar.vx*0.02,ar.y-cam.y-ar.vy*0.02); ctx.stroke();
  }
  ctx.lineWidth=1;

  // частицы
  for(const p of particles){ ctx.fillStyle=p.c; ctx.globalAlpha=clamp(p.t*1.5,0,1); ctx.fillRect(p.x-cam.x-2,p.y-cam.y-2,4,4); }
  ctx.globalAlpha=1;

  // метка цели
  if(player.hasTarget){
    const tx=player.tx-cam.x, ty=player.ty-cam.y;
    ctx.strokeStyle='#ffd34d'; ctx.lineWidth=2;
    const r=6+Math.sin(menuPh*4)*2;
    ctx.beginPath(); ctx.arc(tx,ty,r,0,7); ctx.stroke();
    ctx.lineWidth=1;
  }

  // игрок
  drawChar(ctx, player.x-cam.x, player.y-cam.y, 38, player.rot, player.ph, skinImgOf(selSkin));
  if(player.atkAnim>0){
    const ax=player.x-cam.x+Math.cos(player.rot)*46, ay=player.y-cam.y-16+Math.sin(player.rot)*46;
    ctx.strokeStyle='#fff'; ctx.lineWidth=3;
    ctx.beginPath(); ctx.moveTo(ax-Math.cos(player.rot)*20,ay-Math.sin(player.rot)*20); ctx.lineTo(ax,ay); ctx.stroke();
    ctx.lineWidth=1;
  }
}

