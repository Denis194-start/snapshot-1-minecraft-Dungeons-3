}
function buy(id){
  const s=SHOP.find(v=>v.id===id);
  if(!s || player.emeralds<s.price) return;
  player.emeralds-=s.price;
  if(id==='bow') player.hasBow=true;
  else if(id==='arrows') player.arrows+=10;
  else if(id==='gold') player.weapon='gold';
  else if(id==='diam') player.weapon='diamond';
  else if(id==='potion') player.potions++;
  flash('Куплено: '+s.name);
}

