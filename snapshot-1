function drawHeart(c,x,y,s,frac){
  c.save(); c.translate(x,y); c.scale(s,s);
  c.fillStyle='#222';
  c.beginPath();
  c.moveTo(0,3.2); c.bezierCurveTo(-5,-1,-4.5,-4.6,-2.4,-4.6); c.bezierCurveTo(-1,-4.6,0,-3.6,0,-2.6);
  c.bezierCurveTo(0,-3.6,1,-4.6,2.4,-4.6); c.bezierCurveTo(4.5,-4.6,5,-1,0,3.2);
  c.closePath(); c.fill();
  c.fillStyle='#d33';
  c.beginPath();
  c.moveTo(0,2.6); c.bezierCurveTo(-4.2,-1,-3.8,-3.9,-2,-3.9); c.bezierCurveTo(-0.9,-3.9,0,-3.1,0,-2.2);
  c.bezierCurveTo(0,-3.1,0.9,-3.9,2,-3.9); c.bezierCurveTo(3.8,-3.9,4.2,-1,0,2.6);
  c.closePath(); c.fill();
  if(frac<1){
    c.save(); c.beginPath();
    c.moveTo(0,2.6); c.bezierCurveTo(-4.2,-1,-3.8,-3.9,-2,-3.9); c.bezierCurveTo(-0.9,-3.9,0,-3.1,0,-2.2);
    c.bezierCurveTo(0,-3.1,0.9,-3.9,2,-3.9); c.bezierCurveTo(3.8,-3.9,4.2,-1,0,2.6);
    c.closePath(); c.clip();
    c.fillStyle='#1a1a22'; c.fillRect(-6,(-2.2+2.6*(1-frac))-4,12,8);
    c.restore();
  }
  c.restore();
}
