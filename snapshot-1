function drawHeroPanel(){
  ctx.fillStyle='rgba(8,10,16,0.9)'; ctx.fillRect(0,0,W,H);
  const pw=Math.min(760,W-40), phh=Math.min(560,H-40), px=(W-pw)/2, py=(H-phh)/2;
