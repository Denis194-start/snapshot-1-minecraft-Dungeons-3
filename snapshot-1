  ctx.fillStyle='#fff'; ctx.font='bold 20px monospace'; ctx.textAlign='center';
  ctx.fillText('ВЫБОР ГЕРОЯ', W/2, py+36); ctx.textAlign='left';

  const cols=Math.max(1,Math.floor((pw-40)/150));
  const cellW=150, cellH=190;
  // встроенный скин
  for(let i=0;i<=skins.length;i++){
    const col=i%cols, row=Math.floor(i/cols);
    if(py+70+row*cellH+cellH > py+phh-70) break;
    const cx=px+20+col*cellW, cy2=py+60+row*cellH;
    const isDef=(i===0), skinIdx=i-1;
    const selected = isDef ? (selSkin<0) : (selSkin===skinIdx);
    ctx.fillStyle='rgba(40,46,60,0.9)'; ctx.fillRect(cx,cy2,cellW-10,cellH-10);
    ctx.strokeStyle=selected?'#3ddc6b':'#666'; ctx.lineWidth=selected?3:1; ctx.strokeRect(cx,cy2,cellW-10,cellH-10); ctx.lineWidth=1;
    const im = isDef? null : skinImgOf(skinIdx);
    const ccx=cx+(cellW-10)/2, ccy=cy2+118;
    // плашка фона превью
    ctx.fillStyle='#2b3d26'; ctx.fillRect(cx+2,cy2+70,cellW-14,50);
    drawChar(ctx,ccx,ccy,44,0,menuPh, im);
    ctx.fillStyle='#fff'; ctx.font='11px monospace'; ctx.textAlign='center';
    ctx.fillText(isDef?'Келлен (стандарт)':(skins[skinIdx].name||'Скин '+(skinIdx+1)), ccx, cy2+cellH-32);
    if(selected){ ctx.fillStyle='#3ddc6b'; ctx.fillText('✓ выбран', ccx, cy2+cellH-16); }
    ctx.textAlign='left';
    // клик — выбор
    buttons.push({x:cx,y:cy2,w:cellW-10,h:cellH-16,label:'',fn:()=>{ selSkin=isDef?-1:skinIdx; saveSkins(); }});
    // удалить
    if(!isDef){
      const bx2=cx+cellW-32, by2=cy2+6;
      ctx.fillStyle='#a33'; ctx.fillRect(bx2,by2,20,20);
      ctx.fillStyle='#fff'; ctx.font='bold 13px monospace'; ctx.textAlign='center'; ctx.fillText('✕',bx2+10,by2+14); ctx.textAlign='left';
      const idx=skinIdx;
      buttons.push({x:bx2,y:by2,w:20,h:20,label:'',fn:()=>{
        skins.splice(idx,1); skinImgs.splice(idx,1);
        if(selSkin===idx) selSkin=-1; else if(selSkin>idx) selSkin--;
        saveSkins();
      }});
    }
  }
  const brow=py+phh-58;
  button(px+20,brow,180,40,'Загрузить скин',()=>{ document.getElementById('fileIn').click(); }, {green:true});
  button(px+pw-120,brow,100,40,'Закрыть',()=>{ heroOpen=false; });
}

