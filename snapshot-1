  ctx.fillStyle='rgba(30,0,0,0.7)'; ctx.fillRect(0,0,W,H);
  ctx.fillStyle='#f55'; ctx.font='bold 40px monospace'; ctx.textAlign='center';
  ctx.fillText('ВЫ ПОГИБЛИ', W/2, H/2-80); ctx.textAlign='left';
  buttons=[];
  button(W/2-140,H/2-20,280,46,'Возродиться',()=>{
    player.x=0; player.y=60; player.hp=player.maxHp; player.souls=0;
    player.hasTarget=false; cam.x=player.x-W/2; cam.y=player.y-H/2;
    state=ST.PLAY;
  }, {green:true});
  button(W/2-140,H/2+40,280,46,'Выйти в меню',()=>{ state=ST.MENU; });
}
function drawOver(){
  ctx.fillStyle='rgba(10,4,4,0.85)'; ctx.fillRect(0,0,W,H);
  ctx.fillStyle='#f55'; ctx.font='bold 40px monospace'; ctx.textAlign='center';
  ctx.fillText('ДЕРЕВНЯ РАЗРУШЕНА', W/2, H/2-80); ctx.textAlign='left';
  buttons=[];
  button(W/2-140,H/2-20,280,46,'Начать заново',()=>{ resetGame(); state=ST.PLAY; }, {green:true});
  button(W/2-140,H/2+40,280,46,'В меню',()=>{ state=ST.MENU; });
}

// ================= загрузка скина =================
document.getElementById('fileIn').addEventListener('change', function(){
  const f=this.files[0]; if(!f) return;
  const rd=new FileReader();
  rd.onload=function(){
    const im=new Image();
    im.onload=function(){
      const n=skins.length;
      skins.push({name:f.name.replace(/\.[^.]+$/,'').slice(0,14), data:rd.result});
      skinImgs.push(im);
      selSkin=n;
      saveSkins();
    };
    im.src=rd.result;
  };
  rd.readAsDataURL(f);
  this.value='';
});

// ================= проверка целостности деревни =================
function checkVillage(){
  if(state!==ST.PLAY) return;
  if(houses.every(h=>h.hp<=0)) state=ST.OVER;
}

// ================= главный цикл =================
let last=performance.now();
function loop(now){
  const dt=Math.min(0.05,(now-last)/1000); last=now;
  buttons=[];
  if(state===ST.MENU){ drawMenu(); }
  else {
    update(dt);
    drawWorld();
    drawHUD();
    if(shopOpen){ drawShop(); }
    if(invOpen){ drawInv(); }
    if(state===ST.PAUSE) drawPause();
    if(state===ST.DEAD) drawDead();
    if(state===ST.OVER) drawOver();
    checkVillage();
  }
  if(bigFont) ctx.font='16px monospace';
  if(showFps){ fpsVal=fpsVal*0.95+(1/Math.max(dt,0.001))*0.05;
    ctx.fillStyle='#7f7'; ctx.font='12px monospace'; ctx.fillText(Math.round(fpsVal)+' FPS', 12, H-12); }
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);
</script>
